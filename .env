COMPOSE_PROJECT_NAME=moodle_test

# --- Imagen / PHP ---
MOODLE_PHP_IMAGE=moodlehq/moodle-php-apache:8.2-bookworm

# --- Puertos ---
MOODLE_PORT=8080
ADMINER_PORT=8081

# --- Base de datos ---
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodle
MOODLE_DB_ROOT_PASSWORD=moodleroot

# --- Instalacion / admin ---
MOODLE_WWWROOT=http://localhost:8080
MOODLE_SITE_NAME=Moodle Docker Test
MOODLE_SHORTNAME=moodledocker
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=AdminPass123!
MOODLE_ADMIN_EMAIL=admin@example.com
